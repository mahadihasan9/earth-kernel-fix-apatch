# ---------------------------------------------------------------------------
# Docker / containerd runtime requirements — optional kernel variant.
#
# This fragment is NOT part of the main (default) build.  Merge it on top of
# configs/apatch.fragment only when you want to run a native Docker daemon on
# the device (e.g. dockerd in Termux with root), which needs namespaces,
# cgroup controllers, overlayfs, veth/bridge and iptables NAT.
#
#   OUT=out-docker ./build.sh defconfig configs/apatch.fragment configs/docker.fragment
#
# scripts/build-docker-variant.sh does this and also produces boot-docker.img
# plus a separate sideload zip, so output/boot.img (the normal image) is never
# touched.
#
# Symbols that do not exist in this 4.19 vendor tree are left out on purpose:
#   CONFIG_IP_VS*                      (no IPVS at all in this tree)
#   CONFIG_ANDROID_PARANOID_NETWORK    (absent, so there is nothing to turn off)
# ---------------------------------------------------------------------------

# --- namespaces ------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y

# --- cgroup controllers ----------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
# CONFIG_CGROUP_HUGETLB is not used here: HUGETLB_PAGE is disabled in this vendor tree.
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_KMEM=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y

# --- storage ---------------------------------------------------------------
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y

# --- container networking --------------------------------------------------
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_VXLAN=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y

# --- netfilter / iptables (NAT, port publishing, filter chains) ------------
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y

# --- misc ------------------------------------------------------------------
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NETLINK_DIAG=y
